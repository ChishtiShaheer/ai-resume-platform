# Copy this file to .env and fill in your own values.

ENV=development
SECRET_KEY=replace_this_with_a_random_secret_string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resume_platform

# CORS - comma-separated list is fine to edit directly in config.py if needed
CORS_ORIGINS=["http://localhost:5173"]

# OCR
OCR_ENABLED=true

# LLM provider: "openai", "gemini", or "none" (rule-based/template fallback)
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Scoring weights (must be positive; they're auto-normalized to sum to 1)
WEIGHT_SEMANTIC=0.35
WEIGHT_SKILLS=0.35
WEIGHT_EXPERIENCE=0.20
WEIGHT_EDUCATION=0.10
